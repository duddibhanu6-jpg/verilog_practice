#! /usr/bin/vvp
:ivl_version "12.0 (stable)";
:ivl_delay_selection "TYPICAL";
:vpi_time_precision + 0;
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/system.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/vhdl_sys.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/vhdl_textio.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/v2005_math.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/va_math.vpi";
S_0x5ddf9bc51b70 .scope module, "tb_yes" "tb_yes" 2 1;
 .timescale 0 0;
v0x5ddf9bc77410_0 .var "a", 0 0;
v0x5ddf9bc774e0_0 .var "b", 0 0;
v0x5ddf9bc775b0_0 .net "y", 0 0, L_0x5ddf9bc776b0;  1 drivers
S_0x5ddf9bc66360 .scope module, "uut" "yes" 2 4, 3 1 0, S_0x5ddf9bc51b70;
 .timescale 0 0;
    .port_info 0 /INPUT 1 "a";
    .port_info 1 /INPUT 1 "b";
    .port_info 2 /OUTPUT 1 "y";
L_0x5ddf9bc776b0 .functor OR 1, v0x5ddf9bc77410_0, v0x5ddf9bc774e0_0, C4<0>, C4<0>;
v0x5ddf9bc66590_0 .net "a", 0 0, v0x5ddf9bc77410_0;  1 drivers
v0x5ddf9bc77230_0 .net "b", 0 0, v0x5ddf9bc774e0_0;  1 drivers
v0x5ddf9bc772f0_0 .net "y", 0 0, L_0x5ddf9bc776b0;  alias, 1 drivers
    .scope S_0x5ddf9bc51b70;
T_0 ;
    %vpi_call 2 6 "$dumpfile", "yes.vcd" {0 0 0};
    %vpi_call 2 7 "$dumpvars", 32'sb00000000000000000000000000000000, S_0x5ddf9bc51b70 {0 0 0};
    %vpi_call 2 8 "$display", "                time  a b y" {0 0 0};
    %vpi_call 2 9 "$monitor", "%t  %b %b %b", $time, v0x5ddf9bc77410_0, v0x5ddf9bc774e0_0, v0x5ddf9bc775b0_0 {0 0 0};
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x5ddf9bc77410_0, 0, 1;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x5ddf9bc774e0_0, 0, 1;
    %delay 10, 0;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x5ddf9bc77410_0, 0, 1;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x5ddf9bc774e0_0, 0, 1;
    %delay 10, 0;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x5ddf9bc77410_0, 0, 1;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x5ddf9bc774e0_0, 0, 1;
    %delay 10, 0;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x5ddf9bc77410_0, 0, 1;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x5ddf9bc774e0_0, 0, 1;
    %delay 10, 0;
    %vpi_call 2 14 "$finish" {0 0 0};
    %end;
    .thread T_0;
# The file index is used to find the file name in the following table.
:file_names 4;
    "N/A";
    "<interactive>";
    "tb_yes.v";
    "yes.v";
