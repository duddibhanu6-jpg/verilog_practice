#! /usr/bin/vvp
:ivl_version "12.0 (stable)";
:ivl_delay_selection "TYPICAL";
:vpi_time_precision - 9;
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/system.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/vhdl_sys.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/vhdl_textio.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/v2005_math.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/va_math.vpi";
S_0x5f2a18a9afe0 .scope module, "tb_and_gate" "tb_and_gate" 2 3;
 .timescale -9 -9;
v0x5f2a18ac3330_0 .var "a", 0 0;
v0x5f2a18ac3400_0 .var "b", 0 0;
v0x5f2a18ac34d0_0 .net "y", 0 0, L_0x5f2a18ac35d0;  1 drivers
S_0x5f2a18ab1100 .scope module, "uut" "and_gate" 2 7, 3 1 0, S_0x5f2a18a9afe0;
 .timescale -9 -9;
    .port_info 0 /INPUT 1 "a";
    .port_info 1 /INPUT 1 "b";
    .port_info 2 /OUTPUT 1 "y";
L_0x5f2a18ac35d0 .functor AND 1, v0x5f2a18ac3330_0, v0x5f2a18ac3400_0, C4<1>, C4<1>;
v0x5f2a18ab1330_0 .net "a", 0 0, v0x5f2a18ac3330_0;  1 drivers
v0x5f2a18ac3150_0 .net "b", 0 0, v0x5f2a18ac3400_0;  1 drivers
v0x5f2a18ac3210_0 .net "y", 0 0, L_0x5f2a18ac35d0;  alias, 1 drivers
    .scope S_0x5f2a18a9afe0;
T_0 ;
    %vpi_call 2 10 "$dumpfile", "and_gate.vcd" {0 0 0};
    %vpi_call 2 11 "$dumpvars", 32'sb00000000000000000000000000000000, S_0x5f2a18a9afe0 {0 0 0};
    %vpi_call 2 13 "$display", "Time | A B | Y" {0 0 0};
    %vpi_call 2 14 "$display", "----------------" {0 0 0};
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x5f2a18ac3330_0, 0, 1;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x5f2a18ac3400_0, 0, 1;
    %delay 10, 0;
    %vpi_call 2 17 "$display", "%0t  | %b %b | %b", $time, v0x5f2a18ac3330_0, v0x5f2a18ac3400_0, v0x5f2a18ac34d0_0 {0 0 0};
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x5f2a18ac3330_0, 0, 1;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x5f2a18ac3400_0, 0, 1;
    %delay 10, 0;
    %vpi_call 2 20 "$display", "%0t  | %b %b | %b", $time, v0x5f2a18ac3330_0, v0x5f2a18ac3400_0, v0x5f2a18ac34d0_0 {0 0 0};
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x5f2a18ac3330_0, 0, 1;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x5f2a18ac3400_0, 0, 1;
    %delay 10, 0;
    %vpi_call 2 23 "$display", "%0t  | %b %b | %b", $time, v0x5f2a18ac3330_0, v0x5f2a18ac3400_0, v0x5f2a18ac34d0_0 {0 0 0};
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x5f2a18ac3330_0, 0, 1;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x5f2a18ac3400_0, 0, 1;
    %delay 10, 0;
    %vpi_call 2 26 "$display", "%0t  | %b %b | %b", $time, v0x5f2a18ac3330_0, v0x5f2a18ac3400_0, v0x5f2a18ac34d0_0 {0 0 0};
    %vpi_call 2 28 "$finish" {0 0 0};
    %end;
    .thread T_0;
# The file index is used to find the file name in the following table.
:file_names 4;
    "N/A";
    "<interactive>";
    "tb_and_gate.v";
    "and_gate.v";
